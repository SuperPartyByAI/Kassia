---
import Layout from '../layouts/Layout.astro';

const title = "Mascote pentru petreceri copii București și Ilfov | Kassia Events";
const description = "Mascote pentru petreceri copii București și Ilfov. Cele mai iubite personaje tematice pentru aniversări, grădinițe, școli și petreceri private.";
---

<Layout title={title} description={description} canonical="https://www.kassia.ro/mascote-petreceri-copii-bucuresti/" robots="index, follow">
    <main>
        <section class="py-12 bg-white">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center">
                    <h1 class="text-4xl font-extrabold text-gray-900 tracking-tight sm:text-5xl">Mascote pentru petreceri copii București și Ilfov</h1>
                    <p class="mt-4 max-w-2xl text-xl text-gray-500 mx-auto">Personaje tematice îndrăgite, interacțiune cu copiii, poze, dansuri și mini-disco pentru petreceri memorabile.</p>
                </div>

                <div class="mt-10">
                    <p class="text-lg text-gray-700 mb-6">
                        Surprinde-ți invitații și adu zâmbete pe fețele celor mici chemând <strong>mascote pentru petreceri copii</strong> la evenimentul tău! <strong>Kassia Events</strong> îți pune la dispoziție o selecție premium de mascote Disney și personaje tematice care vor interacționa cu copiii pe tot parcursul petrecerii.
                    </p>
                    <p class="text-lg text-gray-700 mb-6">
                        Fie că organizezi aniversări, serbări la grădinițe, evenimente la școli sau petreceri private, mascotele noastre sunt pregătite pentru sesiuni de poze de neuitat, dansuri distractive, momente tematice și mini-disco. Serviciile noastre acoperă <strong>București și Ilfov</strong>, ajungând oriunde ai nevoie pentru a aduce magia.
                    </p>
                    <p class="text-lg text-gray-700 mb-6">
                        Combină prezența unei mascote cu energia unui animator! Vezi oferta noastră de <a href="/animatori-petreceri-copii/" class="text-purple-600 hover:text-purple-800 font-semibold underline">animatori petreceri copii</a> și <a href="/animatori-petreceri-copii-bucuresti/" class="text-purple-600 hover:text-purple-800 font-semibold underline">animatori petreceri copii București</a>.
                    </p>
                </div>
                
                <div class="mt-8 text-center">
                    <a href="tel:0763795919" class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md shadow-sm text-white bg-purple-600 hover:bg-purple-700">Sună Acum: 0763 795 919</a>
                    <a href="https://wa.me/40763795919" class="ml-4 inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md shadow-sm text-white bg-green-500 hover:bg-green-600">Mesaj WhatsApp</a>
                </div>

                <div class="mt-12 bg-purple-50 rounded-lg p-8">
                    <h2 class="text-2xl font-bold text-gray-900 mb-4">Întrebări Frecvente (FAQ)</h2>
                    <div class="space-y-4">
                        <div>
                            <h3 class="text-lg font-semibold text-gray-900">Ce fel de mascote aveți disponibile?</h3>
                            <p class="text-gray-700">Avem o varietate mare de mascote, inclusiv personajele preferate din desene animate celebre, supereroi și zâne.</p>
                        </div>
                        <div>
                            <h3 class="text-lg font-semibold text-gray-900">Mascotele vin la locații private din Ilfov?</h3>
                            <p class="text-gray-700">Da! Ne deplasăm la orice petrecere din București și Ilfov (inclusiv Otopeni, Voluntari, Chiajna, etc.).</p>
                        </div>
                    </div>
                </div>
                
                <div class="mt-8 text-center pb-8">
                    <a href="/contact/" class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-purple-700 bg-purple-100 hover:bg-purple-200">Contactează-ne</a>
                </div>
            </div>
        </section>
    </main>

<section class="recommended-services py-12 px-4 bg-white text-center">
    <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold mb-6">Servicii recomandate pentru evenimentul tău</h2>
        <ul class="flex flex-col md:flex-row justify-center items-center gap-4">
            <li><a href="/ursitoare-botez-bucuresti/" class="text-blue-600 hover:underline font-semibold">ursitoare botez București</a></li>
            <li><a href="/decoruri-baloane-bucuresti/" class="text-blue-600 hover:underline font-semibold">decoruri baloane București</a></li>
        </ul>
    </div>
</section>

</Layout>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Mascote pentru petreceri copii București și Ilfov",
  "serviceType": "Mascote petreceri",
  "provider": {
    "@type": "EventPlanner",
    "name": "Kassia Events",
    "telephone": "0763795919",
    "url": "https://www.kassia.ro/"
  },
  "areaServed": ["București", "Ilfov", "Voluntari", "Otopeni", "Popești-Leordeni", "Chiajna", "Bragadiru"],
  "description": "Închirieri mascote pentru petreceri copii în București și Ilfov. Personaje tematice, poze și distracție la grădinițe, aniversări și evenimente."
}
</script>
