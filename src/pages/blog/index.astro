---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import { supabase } from '../../lib/supabase';
import {
  SITE_ORIGIN,
  appendSearch,
  getLegacyRedirect,
  isSitemapEligiblePath,
  normalizeRequestPath
} from '../../lib/kassia-routing.mjs';

if (!Astro.url.pathname.endsWith('/')) {
  return Astro.redirect(appendSearch('/blog/', Astro.url.search), 301);
}

const { data: rawArticles, error } = await supabase
  .from('kassia_pages')
  .select('path,title,h1,meta_description,updated_at')
  .eq('status', 'published')
  .eq('index_status', 'index')
  .eq('include_in_sitemap', true)
  .like('path', '/blog/%')
  .order('updated_at', { ascending: false });

if (error) {
  console.error('KASSIA_BLOG_INDEX_QUERY_FAILED', { code: error.code || 'UNKNOWN' });
  return Astro.rewrite('/503');
}

const articlesByPath = new Map();
for (const article of rawArticles || []) {
  const path = normalizeRequestPath(article.path);
  if (
    !path ||
    path === '/blog/' ||
    !isSitemapEligiblePath(path) ||
    getLegacyRedirect(path)
  ) continue;
  if (!articlesByPath.has(path)) articlesByPath.set(path, { ...article, path });
}
const articles = [...articlesByPath.values()];

const title = 'Ghiduri pentru petreceri și evenimente | Kassia';
const description = 'Idei și ghiduri practice pentru petreceri de copii, botezuri și evenimente în București și Ilfov.';
const canonical = `${SITE_ORIGIN}/blog/`;
const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url: canonical
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Kassia', item: `${SITE_ORIGIN}/` },
      { '@type': 'ListItem', position: 2, name: 'Ghiduri', item: canonical }
    ]
  }
];
const staticLinks = [
  { anchor_text: 'Animatori petreceri copii', target_page: { path: '/animatori-petreceri-copii/', status: 'published' } },
  { anchor_text: 'Prețuri animatori copii', target_page: { path: '/preturi-animatori-copii-bucuresti/', status: 'published' } },
  { anchor_text: 'Ursitoare botez București', target_page: { path: '/ursitoare-botez-bucuresti/', status: 'published' } },
  { anchor_text: 'Decoruri cu baloane', target_page: { path: '/decoruri-baloane-bucuresti/', status: 'published' } }
];
---

<Layout title={title} description={description} canonical={canonical} robots="index, follow" schemas={schemas}>
  <div class="blog-index-page">
    <header class="blog-hero">
      <p class="eyebrow">Resurse Kassia</p>
      <h1>Ghiduri pentru petreceri și evenimente</h1>
      <p>Răspunsuri practice despre alegerea programului, organizare, activități și servicii pentru copii.</p>
    </header>

    <main class="blog-content">
      {articles.length > 0 ? (
        <section aria-labelledby="latest-guides">
          <h2 id="latest-guides">Cele mai noi ghiduri</h2>
          <div class="article-grid">
            {articles.map((article) => (
              <article class="article-card">
                <h3><a href={article.path}>{article.h1 || article.title || 'Ghid Kassia'}</a></h3>
                {article.meta_description && <p>{article.meta_description}</p>}
                <a class="read-more" href={article.path}>Citește ghidul</a>
              </article>
            ))}
          </div>
        </section>
      ) : (
        <section class="empty-guides" aria-labelledby="start-here">
          <h2 id="start-here">Începe cu serviciile principale</h2>
          <p>Pregătim ghiduri noi. Până atunci, găsești informațiile esențiale în paginile de servicii și prețuri.</p>
          <div class="service-links">
            <a href="/animatori-petreceri-copii/">Animatori pentru petreceri</a>
            <a href="/preturi-animatori-copii-bucuresti/">Prețuri animatori</a>
            <a href="/decoruri-baloane-bucuresti/">Decoruri cu baloane</a>
          </div>
        </section>
      )}
    </main>

    <Footer internalLinks={staticLinks} />
  </div>
</Layout>

<style>
  .blog-index-page { background: #f8fafc; color: #1e293b; }
  .blog-hero {
    padding: clamp(8rem, 15vw, 11rem) 1.5rem 5rem;
    text-align: center;
    background: linear-gradient(135deg, rgba(168,85,247,.1), rgba(236,72,153,.1));
  }
  .eyebrow { margin: 0 0 .75rem; color: #9333ea; font-size: .82rem; font-weight: 850; letter-spacing: .12em; text-transform: uppercase; }
  .blog-hero h1 { max-width: 900px; margin: 0 auto 1.25rem; font-size: clamp(2.4rem, 7vw, 4.5rem); line-height: 1.05; }
  .blog-hero > p:last-child { max-width: 720px; margin: 0 auto; color: #475569; font-size: 1.15rem; line-height: 1.7; }
  .blog-content { width: min(1180px, calc(100% - 2rem)); margin: 0 auto; padding: 4rem 0 6rem; }
  .blog-content h2 { margin: 0 0 2rem; text-align: center; font-size: clamp(1.8rem, 4vw, 2.7rem); }
  .article-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
  .article-card { display: flex; flex-direction: column; min-height: 230px; padding: 1.5rem; border: 1px solid #e9d5ff; border-radius: 18px; background: #fff; box-shadow: 0 12px 30px rgba(88,28,135,.07); }
  .article-card h3 { margin: 0 0 .8rem; font-size: 1.25rem; line-height: 1.35; }
  .article-card h3 a { color: #1e293b; text-decoration: none; }
  .article-card p { margin: 0 0 1.25rem; color: #475569; line-height: 1.65; }
  .read-more { margin-top: auto; color: #7e22ce; font-weight: 800; }
  .empty-guides { max-width: 820px; margin: 0 auto; padding: 2rem; border-radius: 20px; background: #fff; text-align: center; }
  .empty-guides p { color: #475569; line-height: 1.7; }
  .service-links { display: flex; flex-wrap: wrap; justify-content: center; gap: .75rem; margin-top: 1.5rem; }
  .service-links a { padding: .8rem 1rem; border-radius: 999px; background: #f3e8ff; color: #7e22ce; font-weight: 800; text-decoration: none; }
  @media (max-width: 900px) { .article-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 620px) { .article-grid { grid-template-columns: 1fr; } }
</style>
