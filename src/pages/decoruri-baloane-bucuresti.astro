---
import Layout from '../layouts/Layout.astro';

const title = "Decoruri baloane București și Ilfov | Kassia Events";
const description = "Decoruri din baloane București și Ilfov: arcade organice, ghirlande, panouri foto și aranjamente personalizate cu heliu pentru petreceri și evenimente private.";
---

<Layout title={title} description={description} canonical="https://www.kassia.ro/decoruri-baloane-bucuresti/" robots="index, follow">
    <main>
        <section class="py-12 bg-white">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center">
                    <h1 class="text-4xl font-extrabold text-gray-900 tracking-tight sm:text-5xl">Decoruri baloane București și Ilfov</h1>
                    <p class="mt-4 max-w-2xl text-xl text-gray-500 mx-auto">Arcade din baloane, panouri foto și decoruri tematice perfecte pentru botezuri, aniversări și petreceri.</p>
                </div>

                <div class="mt-10">
                    <p class="text-lg text-gray-700 mb-6">
                        Cadrul perfect pentru poze începe cu aranjamente profesionale. Oferim <strong>decoruri din baloane</strong> pentru orice tip de eveniment în <strong>București și Ilfov</strong>. Echipa Kassia Events creează arcade organice, ghirlande din baloane, decoruri tematice și panouri foto (photo corner) care transformă complet spațiul.
                    </p>
                    <p class="text-lg text-gray-700 mb-6">
                        Ne ocupăm de livrarea și montajul decorurilor la aniversări, botezuri, petreceri pentru copii și evenimente private. Fie că doriți baloane cu heliu clasice sau structuri complexe și cromatice personalizate, echipa noastră asigură calitatea maximă a baloanelor.
                    </p>
                    <p class="text-lg text-gray-700 mb-6">
                        Pentru un eveniment cu adevărat reușit pentru cei mici, vă recomandăm să descoperiți și pachetele noastre de <a href="/animatori-petreceri-copii-bucuresti/" class="text-purple-600 hover:text-purple-800 font-semibold underline">animatori petreceri copii București</a>.
                    </p>
                </div>
                
                <div class="mt-8 text-center">
                    <a href="tel:0763795919" class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md shadow-sm text-white bg-purple-600 hover:bg-purple-700">Sună Acum: 0763 795 919</a>
                    <a href="https://wa.me/40763795919" class="ml-4 inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md shadow-sm text-white bg-green-500 hover:bg-green-600">Mesaj WhatsApp</a>
                </div>

                <div class="mt-12 bg-purple-50 rounded-lg p-8">
                    <h2 class="text-2xl font-bold text-gray-900 mb-4">Întrebări Frecvente (FAQ)</h2>
                    <div class="space-y-4">
                        <div>
                            <h3 class="text-lg font-semibold text-gray-900">Includeți transportul și montajul în București și Ilfov?</h3>
                            <p class="text-gray-700">Da, ne ocupăm de transport, montaj și demontaj (acolo unde este cazul) în orice locație din București și județul Ilfov.</p>
                        </div>
                        <div>
                            <h3 class="text-lg font-semibold text-gray-900">Faceți arcade din baloane personalizate cromatic?</h3>
                            <p class="text-gray-700">Desigur! Adaptăm culorile și tematica exact după preferințele dumneavoastră și tema evenimentului.</p>
                        </div>
                    </div>
                </div>
                
                <div class="mt-8 text-center pb-8">
                    <a href="/contact/" class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-purple-700 bg-purple-100 hover:bg-purple-200">Contactează-ne</a>
                </div>
            </div>
        </section>
    </main>

<section class="recommended-services py-12 px-4 bg-white text-center">
    <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold mb-6">Servicii recomandate pentru evenimentul tău</h2>
        <ul class="flex flex-col md:flex-row justify-center items-center gap-4">
            <li><a href="/mascote-petreceri-copii-bucuresti/" class="text-blue-600 hover:underline font-semibold">mascote pentru petreceri copii</a></li>
            <li><a href="/ursitoare-botez-bucuresti/" class="text-blue-600 hover:underline font-semibold">ursitoare botez București</a></li>
            <li><a href="/animatori-petreceri-copii-bucuresti/" class="text-blue-600 hover:underline font-semibold">animatori petreceri copii București</a></li>
        </ul>
    </div>
</section>

</Layout>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Decoruri baloane București și Ilfov",
  "serviceType": "Decor evenimente",
  "provider": {
    "@type": "EventPlanner",
    "name": "Kassia Events",
    "telephone": "0763795919",
    "url": "https://www.kassia.ro/"
  },
  "areaServed": ["București", "Ilfov", "Voluntari", "Otopeni", "Popești-Leordeni", "Chiajna", "Bragadiru"],
  "description": "Aranjamente și decoruri din baloane: arcade, panouri foto, baloane heliu pentru petreceri, botezuri, aniversări."
}
</script>
<script type="application/ld+json">
