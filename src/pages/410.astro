---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';

Astro.response.status = 410;
Astro.response.statusText = 'Gone';
Astro.response.headers.set('Cache-Control', 'public, max-age=3600');
Astro.response.headers.set('X-Robots-Tag', 'noindex, follow');

const title = 'Pagina nu mai este disponibilă | Kassia';
const description = 'Adresa solicitată a fost retrasă definitiv. Continuă către serviciile actuale Kassia.';
const staticLinks = [
  { anchor_text: 'Animatori petreceri copii', target_page: { path: '/animatori-petreceri-copii/', status: 'published' } },
  { anchor_text: 'Prețuri animatori copii', target_page: { path: '/preturi-animatori-copii-bucuresti/', status: 'published' } },
  { anchor_text: 'Ursitoare botez București', target_page: { path: '/ursitoare-botez-bucuresti/', status: 'published' } },
  { anchor_text: 'Decoruri cu baloane', target_page: { path: '/decoruri-baloane-bucuresti/', status: 'published' } }
];
---

<Layout title={title} description={description} robots="noindex, follow">
  <div class="kassia-premium-page">
    <section class="gone-section">
      <p class="status-code" aria-hidden="true">410</p>
      <h1>Această pagină a fost retrasă definitiv</h1>
      <p>Conținutul vechi nu mai este disponibil. Alege una dintre paginile actuale Kassia.</p>
      <div class="gone-actions">
        <a href="/" class="btn-primary">Pagina principală</a>
        <a href="/animatori-petreceri-copii/" class="btn-secondary">Animatori copii</a>
      </div>
    </section>
    <Footer internalLinks={staticLinks} />
  </div>
</Layout>

<style>
  .gone-section {
    min-height: 68vh;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 1rem;
    padding: clamp(7rem, 14vw, 11rem) 1.5rem 5rem;
    text-align: center;
    background: linear-gradient(135deg, rgba(168,85,247,.08), rgba(236,72,153,.08));
  }
  .status-code {
    margin: 0;
    font-size: clamp(5rem, 18vw, 10rem);
    font-weight: 950;
    line-height: .8;
    background: linear-gradient(90deg, #9333ea, #db2777);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  h1 {
    margin: 1rem 0 0;
    color: #1e293b;
    font-size: clamp(2rem, 6vw, 3.5rem);
    line-height: 1.1;
  }
  .gone-section > p:not(.status-code) {
    max-width: 620px;
    margin: 0;
    color: #475569;
    font-size: 1.1rem;
    line-height: 1.7;
  }
  .gone-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: .8rem;
    margin-top: 1rem;
  }
  .btn-primary, .btn-secondary {
    padding: .95rem 1.4rem;
    border-radius: 999px;
    font-weight: 800;
    text-decoration: none;
  }
  .btn-primary { background: #9333ea; color: #fff; }
  .btn-secondary { border: 2px solid #9333ea; color: #7e22ce; background: #fff; }
</style>
