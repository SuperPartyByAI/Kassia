  "serviceType": "Ursitoare botez",
  "provider": {
    "@type": "EventPlanner",
    "name": "Kassia Events",
    "telephone": "0763795919",
    "url": "https://www.kassia.ro/"
  },
  "areaServed": ["București", "Ilfov", "Voluntari", "Otopeni", "Popești-Leordeni", "Chiajna", "Bragadiru"],
  "description": "Moment artistic cu ursitoare pentru botez în București și Ilfov. Urări personalizate, costume tematice și magie."
}
</script>
