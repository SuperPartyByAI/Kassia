---
import Header from '../components/Header.astro';
import GlobalFloatingCTA from '../components/GlobalFloatingCTA.astro';

export interface Props {
	title: string;
	description: string;
	canonical?: string;
	robots?: string;
	schemas?: any[];
	ogImage?: string;
	isAnimatori?: boolean;
	whatsappMessage?: string;
}

const { title, description, canonical, robots = 'index, follow', schemas = [], ogImage, isAnimatori = false, whatsappMessage } = Astro.props;

const schemaGraph = schemas.map((schema) => {
	const { '@context': _context, ...rest } = schema || {};
	return rest;
});
const schemaJson = JSON.stringify({
	'@context': 'https://schema.org',
	'@graph': schemaGraph
}).replace(/</g, '\\u003c');
---

<!DOCTYPE html>
<html lang="ro">
	<head>
		<meta charset="UTF-8" />
		<meta name="google-site-verification" content="tYYr4DkXrfYAVYO5EDy1Kyq0282U7AQTPyBBM9ecaPA" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content={robots} />
		{canonical && <link rel="canonical" href={canonical} />}

		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonical && <meta property="og:url" content={canonical} />}
		<meta property="og:type" content="website" />
		{ogImage && <meta property="og:image" content={ogImage} />}

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{ogImage && <meta name="twitter:image" content={ogImage} />}
		
		<meta name="generator" content={Astro.generator} />

		{schemaGraph.length > 0 && (
			<script type="application/ld+json" set:html={schemaJson} />
		)}
	</head>
	<body>
		<Header whatsappMessage={whatsappMessage} isAnimatori={isAnimatori} />
		<main>
			<slot />
		</main>
		<GlobalFloatingCTA isAnimatori={isAnimatori} whatsappMessage={whatsappMessage} />
	</body>
</html>

<style is:global>
	:root {
		--font-family: 'Inter', system-ui, sans-serif;
	}
	html, body {
		margin: 0;
		padding: 0;
		width: 100%;
		max-width: 100vw;
		overflow-x: hidden;
	}
	body {
		font-family: var(--font-family);
		background-color: #f8fafc;
		color: #0f172a;
		padding-bottom: 80px; /* Space for mobile CTA */
	}
	@media (min-width: 769px) {
		body { padding-bottom: 0; }
	}
</style>
