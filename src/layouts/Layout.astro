---
import Header from '../components/Header.astro';
import GlobalFloatingCTA from '../components/GlobalFloatingCTA.astro';

export interface Props {
	title: string;
	description: string;
	canonical: string;
	robots: string;
	schemas?: any[];
	ogImage?: string;
}

const { title, description, canonical, robots, schemas = [], ogImage } = Astro.props;
---

<!DOCTYPE html>
<html lang="ro">
	<head>
		<meta charset="UTF-8" />
		<meta name="google-site-verification" content="tYYr4DkXrfYAVYO5EDy1Kyq0282U7AQTPyBBM9ecaPA" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content={robots} />
		<link rel="canonical" href={canonical} />

		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:type" content="website" />
		{ogImage && <meta property="og:image" content={ogImage} />}

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{ogImage && <meta name="twitter:image" content={ogImage} />}
		
		<meta name="generator" content={Astro.generator} />

		{schemas && schemas.length > 0 && (
			<script type="application/ld+json" set:html={JSON.stringify({
				"@context": "https://schema.org",
				"@graph": schemas.map(s => {
					const { "@context": _, ...rest } = s;
					return rest;
				})
			})} />
		)}
	</head>
	<body>
		<Header />
		<main>
			<slot />
		</main>
		<GlobalFloatingCTA />
	</body>
</html>

<style is:global>
	:root {
		--font-family: 'Inter', system-ui, sans-serif;
	}
	body {
		margin: 0;
		font-family: var(--font-family);
		background-color: #f8fafc;
		color: #0f172a;
		padding-bottom: 80px; /* Space for mobile CTA */
	}
	@media (min-width: 769px) {
		body { padding-bottom: 0; }
	}
</style>
