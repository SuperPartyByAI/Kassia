---
export interface Props {
  phone: string;
  whatsappNumber: string;
  whatsappText: string;
}

const { phone, whatsappNumber, whatsappText } = Astro.props;

const phoneClean = phone.replace(/[^0-9]/g, '');
const whatsappLink = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappText)}`;
---

<div class="mobile-floating-cta">
  <div class="cta-buttons">
    <a 
      href={`tel:${phoneClean}`} 
      class="cta-btn cta-call" 
      aria-label="Sună Kassia"
    >
      <svg class="cta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
      </svg>
      <span>Sună</span>
    </a>
    <a 
      href={whatsappLink} 
      class="cta-btn cta-whatsapp" 
      target="_blank" 
      rel="noopener" 
      aria-label="Scrie pe WhatsApp către Kassia"
    >
      <svg class="cta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
      </svg>
      <span>WhatsApp</span>
    </a>
  </div>
</div>

<style>
  .mobile-floating-cta {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 99;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-top: 1px solid rgba(226, 232, 240, 0.8);
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.05);
    padding: 0.75rem 1rem;
    padding-bottom: calc(0.75rem + env(safe-area-inset-bottom));
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    max-width: 600px;
    margin: 0 auto;
  }

  .cta-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.85rem;
    border-radius: 12px;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    transition: transform 0.2s ease, filter 0.2s ease;
    text-align: center;
  }

  .cta-btn:active {
    transform: scale(0.97);
  }

  .cta-call {
    background-color: #a855f7;
    color: #ffffff;
  }

  .cta-whatsapp {
    background-color: #22c55e;
    color: #ffffff;
  }

  .cta-icon {
    width: 20px;
    height: 20px;
  }

  @media (min-width: 769px) {
    .mobile-floating-cta {
      display: none;
    }
  }
</style>
