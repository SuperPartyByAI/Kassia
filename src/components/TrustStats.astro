---
// TrustStats.astro
// Clean, light-themed stats grid designed to integrate seamlessly into the Kassia site structure
// Restored with neutral customer statistics and an H3 heading to prevent H2 conflicts.
---

<section class="cifre-kassia-sectiune bg-light" id="kassia-stats-cifre">
  <div class="container">
    <div class="cifre-kassia-header text-center">
      <h3 class="section-heading">Experiență și profesionalism în cifre</h3>
      <p class="section-subtitle">Suntem dedicați organizării de petreceri pentru copii în București și Ilfov, cu programe de animație adaptate evenimentului.</p>
    </div>

    <div class="cifre-kassia-grid">
      {/* CARD 1: RECENZII CLIENTI */}
      <div class="cifra-kassia-card">
        <div class="cifra-kassia-icon-wrapper opinie-bg">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" width="26" height="26">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 9.75a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
        </div>
        <div class="cifra-kassia-numar">2687+</div>
        <h4 class="cifra-kassia-label">Recenzii clienți</h4>
        <p class="cifra-kassia-meta">De la clienți mulțumiți</p>
      </div>

      {/* CARD 2: RATING CLIENTI */}
      <div class="cifra-kassia-card">
        <div class="cifra-kassia-icon-wrapper stele-bg">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" width="26" height="26">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499c.176-.47 1.177-.47 1.353 0l2.22 5.922a1 1 0 00.95.69h6.3c.969 0 1.371 1.24.588 1.81l-5.1 3.707a1 1 0 00-.363 1.118l2.22 5.922c.176.47-.352.852-.767.551l-5.1-3.707a1 1 0 00-1.164 0l-5.1 3.707c-.415.3-.943-.081-.767-.551l2.22-5.922a1 1 0 00-.363-1.118l-5.1-3.707c-.783-.57-.38-1.81.588-1.81h6.3a1 1 0 00.95-.69l2.22-5.922z" />
          </svg>
        </div>
        <div class="cifra-kassia-numar">4.9</div>
        <h4 class="cifra-kassia-label">Rating clienți Kassia</h4>
        <div class="cifra-kassia-stele">
          {"★★★★★".split('').map(star => <span class="s-star">{star}</span>)}
        </div>
      </div>

      {/* CARD 3: PETRECERI ORGANIZATE */}
      <div class="cifra-kassia-card">
        <div class="cifra-kassia-icon-wrapper petreceri-bg">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" width="26" height="26">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 21.75V19.5m0 0a3.75 3.75 0 003.75-3.75V11.25a3.75 3.75 0 00-7.5 0v4.5a3.75 3.75 0 003.75 3.75zm0 0l-1.5 2.25h3L12 19.5z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 7.5a2.25 2.25 0 014.5 0" />
          </svg>
        </div>
        <div class="cifra-kassia-numar">Peste 17k</div>
        <h4 class="cifra-kassia-label">Petreceri organizate</h4>
        <p class="cifra-kassia-meta">Zâmbete și copii fericiți</p>
      </div>

      {/* CARD 4: ANI EXPERIENTA */}
      <div class="cifra-kassia-card">
        <div class="cifra-kassia-icon-wrapper experienta-bg">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" width="26" height="26">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 013 3h-15a3 3 0 013-3m9 0v-3.375c0-.621-.504-1.125-1.125-1.125h-6.75a1.125 1.125 0 00-1.125 1.125v3.375m9 0h-9m10.125-9H18.75m-13.5 0H3.375m0 0A1.125 1.125 0 012.25 8.25v-.75A1.125 1.125 0 013.375 6.375H5.25m-1.875 3h1.875m10.125-3h1.875A1.125 1.125 0 0121.75 7.5v.75a1.125 1.125 0 01-1.125 1.125H18.75m1.875-3H18.75m-13.5 0V11.25c0 .621.504 1.125 1.125 1.125h6.75c.621 0 1.125-.504 1.125-1.125V6.375m-9 0h9" />
          </svg>
        </div>
        <div class="cifra-kassia-numar">Peste 15 ani</div>
        <h4 class="cifra-kassia-label">Experiență</h4>
        <p class="cifra-kassia-meta">Animatori profesioniști</p>
      </div>
    </div>
  </div>
</section>

<style>
  .cifre-kassia-sectiune {
    padding: 5rem 0;
  }
  
  .cifre-kassia-header {
    max-width: 700px;
    margin: 0 auto 3rem;
  }

  .section-heading {
    font-size: clamp(2rem, 3.5vw, 2.5rem);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 1rem;
    color: #0f172a;
  }

  .section-subtitle {
    color: #475569;
    font-size: 1.1rem;
    line-height: 1.6;
    max-width: 600px;
    margin: 0 auto;
  }

  .cifre-kassia-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .cifre-kassia-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .cifre-kassia-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .cifra-kassia-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    padding: 2.5rem 1.5rem;
    text-align: center;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cifra-kassia-card:hover {
    transform: translateY(-4px);
    border-color: rgba(168, 85, 247, 0.3);
    box-shadow: 0 12px 20px -8px rgba(168, 85, 247, 0.15), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  }

  .cifra-kassia-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    margin-bottom: 1.25rem;
  }

  /* COLOR BADGES FOR ICONS */
  .opinie-bg {
    background: rgba(168, 85, 247, 0.08);
    color: #a855f7;
  }
  .stele-bg {
    background: rgba(236, 72, 153, 0.08);
    color: #ec4899;
  }
  .petreceri-bg {
    background: rgba(168, 85, 247, 0.08);
    color: #a855f7;
  }
  .experienta-bg {
    background: rgba(14, 165, 233, 0.08);
    color: #0ea5e9;
  }

  .cifra-kassia-numar {
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 0.5rem;
    color: #9333ea;
    background: linear-gradient(to right, #9333ea, #db2777);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .cifra-kassia-label {
    font-size: 1.05rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 0.25rem;
  }

  .cifra-kassia-meta {
    font-size: 0.85rem;
    color: #64748b;
    margin: 0;
  }

  .cifra-kassia-stele {
    display: flex;
    gap: 2px;
    margin-top: 0.25rem;
  }

  .s-star {
    color: #fbbf24;
    font-size: 1rem;
  }
</style>
